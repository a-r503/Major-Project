# FoodGuard AI - Environment Configuration Template

PROJECT_NAME="FoodGuard AI"
VERSION="2.0.0"
API_PREFIX="/api"

# Security & Tokens
SECRET_KEY="foodguard-super-secret-key-32chars-2026-hypersecure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Centralized Relational Database (Defaults to local SQLite if unset)
DATABASE_URL="sqlite:///foodguard.db"
# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/foodguard"

# Google Gemini API Key for Natural Language Explanation Generation (Optional)
# If empty, the system utilizes its built-in deterministic forensic report synthesizer
GEMINI_API_KEY=""

# Computer Vision Thresholds
CONFIDENCE_THRESHOLD=0.25
TAMPER_SIMILARITY_THRESHOLD=0.72
